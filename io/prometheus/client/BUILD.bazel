"""
Prometheus Client Model - Protocol Buffer definitions
"""

load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_cc//cc:defs.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# Main protocol buffer definition for Prometheus metrics
proto_library(
    name = "metrics_proto",
    srcs = ["metrics.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
    ],
)

# C++ library for Prometheus metrics
cc_proto_library(
    name = "metrics_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":metrics_proto"],
)

# Python library for Prometheus metrics
py_proto_library(
    name = "metrics_py_proto",
    visibility = ["//visibility:public"],
    deps = [":metrics_proto"],
)

# Go library for Prometheus metrics
go_proto_library(
    name = "client_go_proto",
    importpath = "github.com/prometheus/client_model/go",
    proto = ":metrics_proto",
    visibility = ["//visibility:public"],
)

# Envoy compatibility: api_cc_py_proto_library creates a proto_library target
# named "client_model" that consumers can depend on
alias(
    name = "client_model",
    actual = ":metrics_proto",
    visibility = ["//visibility:public"],
)

# Envoy compatibility: Go proto alias
alias(
    name = "client_model_go_proto",
    actual = ":client_go_proto",
    visibility = ["//visibility:public"],
)

# Envoy compatibility: C++ proto library (if consumers need C++ specifically)
alias(
    name = "client_model_cc_proto",
    actual = ":metrics_cc_proto",
    visibility = ["//visibility:public"],
)

# Envoy compatibility: Python proto library (if consumers need Python specifically)
alias(
    name = "client_model_py_proto",
    actual = ":metrics_py_proto",
    visibility = ["//visibility:public"],
)
