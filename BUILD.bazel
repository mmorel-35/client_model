"""
Prometheus Client Model - Root BUILD file
"""

load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/prometheus/client_model
gazelle(name = "gazelle")

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=deps.bzl%go_dependencies",
        "-prune",
    ],
    command = "update-repos",
)

exports_files([
    "go.mod",
    "go.sum",
])
